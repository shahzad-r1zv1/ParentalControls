Graceful Session Flush on SIGTERM
python# daemon/time_tracker.py

def close_open_session(self):
    """
    Called on SIGTERM. If a session is currently being tracked,
    write the final end_time and duration before the process exits.
    """
    if self._current_session_id:
        now = datetime.utcnow()
        duration = int((now - self._session_start).total_seconds())
        queries.close_session(self.db, self._current_session_id,
                              end_time=now, duration_secs=duration)
Config Hot-Reload (config/loader.py)
pythonimport threading

class Config:
    def __init__(self, path: str):
        self._path = path
        self._lock = threading.RLock()
        self._data = self._load()

    def reload(self):
        """Thread-safe reload. Called from SIGUSR1 handler."""
        new_data = self._load()
        with self._lock:
            self._data = new_data

    def __getattr__(self, name):
        with self._lock:
            return self._data[name]
