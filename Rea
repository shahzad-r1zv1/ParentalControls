Key Implementation Details
Signal Handling (daemon/main.py)
pythonimport signal, threading

shutdown_event = threading.Event()

def handle_sigterm(signum, frame):
    # Flush open usage session before exit
    tracker.close_open_session()
    scheduler.shutdown(wait=False)
    shutdown_event.set()

def handle_sigusr1(signum, frame):
    # Hot-reload config without restart (called after dashboard saves settings)
    config.reload()
    enforcer.reload_config(config)
    tracker.reload_config(config)

signal.signal(signal.SIGTERM, handle_sigterm)
signal.signal(signal.SIGUSR1, handle_sigusr1)
