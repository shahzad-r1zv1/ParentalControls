Browser History: Safe SQLite Copy (monitor/browser_history.py)
pythonimport shutil, sqlite3, tempfile
from pathlib import Path

def import_browser_history(username: str, db):
    """
    Firefox holds an exclusive write lock on places.sqlite while running.
    We copy it to a temp file before reading; discard after.
    We only import rows newer than the last cursor to avoid duplicates.
    """
    profile_dir = _find_firefox_profile(username)
    src = profile_dir / "places.sqlite"
    if not src.exists():
        return

    with tempfile.NamedTemporaryFile(suffix=".sqlite", delete=False) as tmp:
        tmp_path = tmp.name

    try:
        shutil.copy2(src, tmp_path)            # Copy while Firefox may have it open
        last_cursor = queries.get_history_cursor(db, username)  # UTC timestamp
        conn = sqlite3.connect(f"file:{tmp_path}?mode=ro&immutable=1", uri=True)
        rows = _read_visits_since(conn, last_cursor)
        conn.close()

        if rows:
            queries.insert_browser_visits(db, username, rows)
            queries.update_history_cursor(db, username, max(r['visit_time'] for r in rows))
    finally:
        Path(tmp_path).unlink(missing_ok=True)
ai_decisions.conf Regeneration (Never Append)
Appending to the conf file causes:

Duplicate address=/domain/# entries if a domain gets re-classified
Unbounded file growth (thousands of entries after months)
dnsmasq reads the whole file on reload anyway, so regenerating is identical cost

python# filter/ai_filter.py

def regenerate_ai_decisions_conf(db, conf_path: str):
    """
    Regenerate ai_decisions.conf atomically from all 'block' decisions in DB.
    Uses a temp file + os.replace for atomicity (no partial reads by dnsmasq).
    """
    import os, tempfile

    blocked_domains = queries.get_all_blocked_ai_domains(db)

    tmp_fd, tmp_path = tempfile.mkstemp(dir=os.path.dirname(conf_path), suffix=".tmp")
    try:
        with os.fdopen(tmp_fd, 'w') as f:
            f.write("# Auto-generated by EduGuard ai_filter. Do not edit.\n")
            f.write(f"# Last updated: {datetime.utcnow().isoformat()}Z\n\n")
            for domain, reason in blocked_domains:
                f.write(f"address=/{domain}/#  # {reason}\n")
        os.replace(tmp_path, conf_path)   # Atomic on same filesystem
    except Exception:
        os.unlink(tmp_path)
        raise

    reload_dnsmasq()
