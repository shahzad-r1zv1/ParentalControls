[Unit]
Description=EduGuard Parental Control Daemon
After=network.target dnsmasq.service

[Service]
Type=simple
User=root
Group=root
Environment="ANTHROPIC_API_KEY="
Environment="FLASK_SECRET_KEY="
ExecStart=/usr/bin/python3 -m eduguard.daemon.daemon
Restart=always
RestartSec=10
PIDFile=/var/run/eduguard.pid

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/eduguard /var/log/eduguard /tmp

[Install]
WantedBy=multi-user.target
